# DocuMind AI — environment variable template
# Copy this file to .env.local and fill in your values.
# .env.local is git-ignored and must never be committed.

# ============================================================
# Google Gemini API
# Get your key at: https://aistudio.google.com/apikey
# ============================================================
GEMINI_API_KEY=

# Model identifiers — verify availability with your API key:
#   npx tsx scripts/verify-models.ts
#
# Embedding model — verified working, produces 768-dim embeddings with taskType support
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Default generation model. Recommended for new projects (Oct 2026):
#   gemini-3.5-flash-lite  — verified reachable (use this)
#   gemini-3.8-flash       — higher capacity; daily quota may be exhausted on free tier
#   gemini-2.5-flash       — legacy, restricted to existing projects
# Run scripts/verify-models.ts to confirm access with your API key.
GEMINI_GENERATION_MODEL=gemini-3.5-flash-lite

# ============================================================
# Supabase
# Get these from: Supabase Dashboard → Project Settings → API
# ============================================================

# Project URL — safe to expose, used by both server and client
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Anon (public) key — safe to expose, used for browser-side reads if needed
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — SERVER ONLY, bypasses Row Level Security
# Never prefix with NEXT_PUBLIC_ and never commit this value
SUPABASE_SERVICE_ROLE_KEY=

# ============================================================
# Feature flags
# Set to 'false' in the Vercel production environment to disable
# document uploads and deletions for the public demo.
# ============================================================
ENABLE_UPLOAD=true
ENABLE_DELETE=true

# ============================================================
# Rate limiting
# Server-only HMAC secret for pseudonymising client IP addresses.
# The raw IP is never stored; only HMAC-SHA-256(ip, secret) is sent to the DB.
#
# Must never use the NEXT_PUBLIC_ prefix.
# Must never be committed.
# Must be at least 32 characters.
#
# Generate a secure value with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ============================================================
RATE_LIMIT_SECRET=replace-with-a-long-randomly-generated-secret
